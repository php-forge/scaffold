#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * Runs the `php-forge/scaffold` console application with the autoloader published by Composer's `vendor/bin` proxy,
 * falling back to the autoloader of the plugin checkout or of the consumer project.
 */

use PHPForge\Scaffold\Console\Application;

// Composer's 'vendor/bin' proxies (2.2+) expose the consumer autoloader path; the relative candidates cover direct
// invocation of the plugin checkout and of an installed copy without a proxy.
$autoloadCandidates = [];

if (isset($GLOBALS['_composer_autoload_path']) && is_string($GLOBALS['_composer_autoload_path'])) {
    $autoloadCandidates[] = $GLOBALS['_composer_autoload_path'];
}

$autoloadCandidates[] = __DIR__ . '/../vendor/autoload.php';
$autoloadCandidates[] = __DIR__ . '/../../../autoload.php';

foreach ($autoloadCandidates as $autoloadPath) {
    if (is_file($autoloadPath)) {
        require $autoloadPath;

        break;
    }
}

if (class_exists(Application::class) === false) {
    fwrite(STDERR, '[scaffold] Unable to locate Composer autoloader. Run "composer install" first.' . PHP_EOL);

    exit(1);
}

exit((new Application())->run());
