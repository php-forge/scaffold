{
    "name": "php-forge/scaffold",
    "type": "composer-plugin",
    "description": "Declarative multi-layer file scaffolding for PHP projects via Composer providers and a Symfony Console CLI.",
    "keywords": [
        "php",
        "php-forge",
        "composer-plugin",
        "scaffold",
        "scaffolding",
        "file-mapping"
    ],
    "license": "BSD-3-Clause",
    "authors": [
        {
            "name": "Wilmer Arambula",
            "email": "terabytesoftw@gmail.com",
            "homepage": "https://github.com/terabytesoftw",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=8.3",
        "composer-plugin-api": "^2.3",
        "php-forge/diff": "^0.1",
        "symfony/console": "^7.4 || ^8.0"
    },
    "bin": [
        "bin/scaffold"
    ],
    "require-dev": {
        "composer/composer": "^2.10",
        "infection/infection": "^0.35",
        "llm/skills": "^1.15",
        "maglnet/composer-require-checker": "^4.1",
        "php-forge/coding-standard": "^0.3",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.2",
        "phpstan/phpstan-strict-rules": "^2.0",
        "testo/bridge-infection": "^0.1.9",
        "testo/testo": "^0.10.56"
    },
    "autoload": {
        "psr-4": {
            "PHPForge\\Scaffold\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PHPForge\\Scaffold\\Tests\\": "tests/"
        }
    },
    "extra": {
        "class": "PHPForge\\Scaffold\\Plugin",
        "branch-alias": {
            "dev-main": "0.3.x-dev"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "infection/extension-installer": true,
            "llm/skills": true,
            "phpstan/extension-installer": true
        }
    },
    "scripts": {
        "check-dependencies": "./vendor/bin/composer-require-checker check",
        "ecs": "./vendor/bin/ecs --fix",
        "mutation": [
            "Composer\\Config::disableProcessTimeout",
            "@php -d memory_limit=-1 ./vendor/bin/infection"
        ],
        "mutation-static": "@mutation --static-analysis-tool=phpstan",
        "rector": "./vendor/bin/rector process",
        "static": "./vendor/bin/phpstan --memory-limit=-1",
        "tests": "./vendor/bin/testo",
        "tests-unit": "./vendor/bin/testo --suite=Unit"
    }
}
